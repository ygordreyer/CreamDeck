  "01-qam-active": "<div style=\"{&quot;padding&quot;:&quot;1em&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><button>Open game</button>\n<p role=\"status\">Library menu unavailable</p>\n<button>First game (Installed)</button>\n<button>Second game (Setup pending)</button>\n<button>(?)</button>\n</div>\n",

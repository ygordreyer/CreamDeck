  "05-ready-long-dlc": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Not installed</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><div><label>A long DLC name with plenty of words to wrap in a narrow panel<input type=\"checkbox\"></label>\n</div>\n<div><label>Second DLC<input type=\"checkbox\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button>Install</button>\n</div>\n</section>\n<section><h2>Options</h2><div><label>Install mode</label>\n<select aria-label=\"Install mode\"><option selected=\"true\">Replace game files</option><option>Add a launch helper</option></select>\n</div>\n<div><button>Refresh</button>\n</div>\n</section>\n</div>\n",
  "06-installed-direct": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Installed</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>No DLC listed</p>\n<div><label>DLC 456<input type=\"checkbox\" checked=\"true\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button disabled=\"true\">Save DLC selection</button>\n</div>\n</section>\n<section><h2>Options</h2><p>Game files replaced</p>\n<div><button>Refresh</button>\n</div>\n<div><button>Remove</button>\n</div>\n</section>\n</div>\n",
  "07-installed-proxy": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Installed</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>No DLC listed</p>\n<div><label>DLC 456<input type=\"checkbox\" checked=\"true\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button disabled=\"true\">Save DLC selection</button>\n</div>\n</section>\n<section><h2>Options</h2><p>Launch helper added</p>\n<div><button>Refresh</button>\n</div>\n<div><button>Remove</button>\n</div>\n</section>\n</div>\n",
  "15-failed-refresh": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Status stale</p>\n<p role=\"alert\">Action failed. See (?)</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>No DLC listed</p>\n<div><label>DLC 456<input type=\"checkbox\" disabled=\"true\" checked=\"true\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button disabled=\"true\">Save DLC selection</button>\n</div>\n</section>\n<section><h2>Options</h2><p>Launch helper added</p>\n<div><button>Refresh</button>\n</div>\n<div><button disabled=\"true\">Remove</button>\n</div>\n</section>\n</div>\n",
  "08-proxy-setup-pending": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Setup pending</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>No DLC listed</p>\n<div><label>DLC 456<input type=\"checkbox\" checked=\"true\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button>Finish launch setup</button>\n</div>\n<div><button disabled=\"true\">Save DLC selection</button>\n</div>\n</section>\n<section><h2>Options</h2><p>Launch helper added</p>\n<div><button>Refresh</button>\n</div>\n<div><button>Remove</button>\n</div>\n</section>\n</div>\n",
  "09-metadata-unavailable": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Installed</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>DLC metadata unavailable</p>\n<div><label>DLC 456<input type=\"checkbox\" checked=\"true\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button disabled=\"true\">Save DLC selection</button>\n</div>\n</section>\n<section><h2>Options</h2><p>Launch helper added</p>\n<div><button>Refresh</button>\n</div>\n<div><button>Remove</button>\n</div>\n</section>\n</div>\n",
  "10-restoration-pending": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Restoration pending</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>No DLC listed</p>\n<div><label>DLC 456<input type=\"checkbox\" checked=\"true\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button disabled=\"true\">Install</button>\n</div>\n<p>Restore launch options first</p>\n</section>\n<section><h2>Options</h2><div><label>Install mode</label>\n<select aria-label=\"Install mode\"><option selected=\"true\">Replace game files</option><option>Add a launch helper</option></select>\n</div>\n<div><button>Refresh</button>\n</div>\n<div><button>Restore launch options</button>\n</div>\n<div><button>Confirm manual restore</button>\n</div>\n</section>\n</div>\n",
  "11-storage-unavailable": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Steam app 123</h1>\n<p role=\"status\">Storage unavailable</p>\n<p role=\"alert\">Action failed. See (?)</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>Loading DLC</p>\n</section>\n<section><h2>SmokeAPI</h2><div><button disabled=\"true\">Install</button>\n</div>\n<p>Refresh status first</p>\n</section>\n<section><h2>Options</h2><div><label>Install mode</label>\n<select disabled=\"true\" aria-label=\"Install mode\"><option selected=\"true\">Replace game files</option><option>Add a launch helper</option></select>\n</div>\n<div><label>Offline single-player, no anti-cheat<input type=\"checkbox\" disabled=\"true\"></label>\n</div>\n<div><button disabled=\"true\">Allow game</button>\n</div>\n<div><button>Refresh</button>\n</div>\n</section>\n</div>\n",
  "12-open-help": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Installed</p>\n<button>(?)</button>\n<div role=\"dialog\" aria-label=\"CreamDeck help\" style=\"{&quot;overflowWrap&quot;:&quot;anywhere&quot;,&quot;whiteSpace&quot;:&quot;normal&quot;}\"><h2>Help</h2>\n<p>Close the game before changing files. Use only offline single-player games with no anti-cheat. Marker scans cannot prove a game is safe. DLC files must already be installed.</p>\n<p>DLC switches edit the selection. Save applies it to this game only. Refresh discards unsaved edits. Metadata may be unavailable; saved DLC IDs remain available.</p>\n<p>Replace game files (direct mode) replaces the Steam API DLL. Add a launch helper (proxy mode) needs a free DLL name in the top game folder and a Wine launch override. Helper 1 is version.dll, Helper 2 is winmm.dll, and Helper 3 is winhttp.dll. Simple options can be applied automatically. For complex options, enable manual setup and confirm after setting the override in Steam Properties.</p>\n<p>Finish launch setup retries Steam options without reinstalling files. Owner edits are preserved. Confirm manual setup only after applying the override yourself.</p>\n<p>Remove preserves changed files. When recovery reports a mismatch, run Verify integrity in Steam. Confirm manual restore only after restoring the saved original in Steam Properties.</p>\n<p>Saved original launch options: <code style=\"{&quot;overflowWrap&quot;:&quot;anywhere&quot;,&quot;whiteSpace&quot;:&quot;pre-wrap&quot;,&quot;wordBreak&quot;:&quot;break-word&quot;}\">&quot;&quot;</code>\n</p>\n<p>Required override: <code style=\"{&quot;overflowWrap&quot;:&quot;anywhere&quot;}\">WINEDLLOVERRIDES=&quot;version=n,b&quot;</code>\n</p>\n<p>installed</p>\n<button>Close help</button>\n</div>\n<section><h2>DLC selection</h2><p>No DLC listed</p>\n<div><label>DLC 456<input type=\"checkbox\" checked=\"true\"></label>\n</div>\n</section>\n<section><h2>SmokeAPI</h2><div><button disabled=\"true\">Save DLC selection</button>\n</div>\n</section>\n<section><h2>Options</h2><p>Launch helper added</p>\n<div><button>Refresh</button>\n</div>\n<div><button>Remove</button>\n</div>\n</section>\n</div>\n",
  "13-metadata-loading": "<div style=\"{&quot;padding&quot;:&quot;56px 24px&quot;,&quot;height&quot;:&quot;100%&quot;,&quot;boxSizing&quot;:&quot;border-box&quot;,&quot;overflowY&quot;:&quot;auto&quot;,&quot;overflowWrap&quot;:&quot;anywhere&quot;}\"><h1>Selected game</h1>\n<p role=\"status\">Not installed</p>\n<button>(?)</button>\n<section><h2>DLC selection</h2><p>Loading DLC</p>\n</section>\n<section><h2>SmokeAPI</h2><div><button>Install</button>\n</div>\n</section>\n<section><h2>Options</h2><div><label>Install mode</label>\n<select aria-label=\"Install mode\"><option selected=\"true\">Replace game files</option><option>Add a launch helper</option></select>\n</div>\n<div><button>Refresh</button>\n</div>\n</section>\n</div>\n",
